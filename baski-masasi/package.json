{
  "name": "baski-masasi",
  "productName": "Baskı Masası",
  "version": "1.0.0",
  "description": "Kırtasiyeler için sürükle-bırak çıktı hazırlama: kareli/çizgili sayfalar, kapaklar, PDF ve arkalı önlü yazdırma.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "vendor": "node -e \"const fs=require('fs'),s='node_modules/pdfjs-dist/',d='renderer/vendor/';fs.mkdirSync(d,{recursive:true});for(const f of ['pdf.min.js','pdf.worker.min.js'])fs.copyFileSync(s+'build/'+f,d+f);for(const f of ['cmaps','standard_fonts'])fs.cpSync(s+f,d+f,{recursive:true});fs.copyFileSync(s+'LICENSE',d+'PDFJS-LICENSE')\""
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "pdfjs-dist": "3.11.174"
  },
  "build": {
    "appId": "com.baskimasasi.app",
    "productName": "Baskı Masası",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Baskı Masası"
    }
  }
}
