{
  "name": "baski-masasi",
  "productName": "Baskı Masası",
  "version": "1.1.0",
  "description": "Kırtasiyeler için sürükle-bırak çıktı hazırlama: kareli/çizgili sayfalar, kapaklar, PDF ve arkalı önlü yazdırma. Windows 7, 8, 10 ve 11'de (32/64 bit) çalışır.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "vendor": "node -e \"const fs=require('fs'),s='node_modules/pdfjs-dist/',d='renderer/vendor/';fs.mkdirSync(d,{recursive:true});for(const f of ['pdf.min.js','pdf.worker.min.js'])fs.copyFileSync(s+'build/'+f,d+f);for(const f of ['cmaps','standard_fonts'])fs.cpSync(s+f,d+f,{recursive:true});fs.copyFileSync(s+'LICENSE',d+'PDFJS-LICENSE')\""
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "25.1.8",
    "pdfjs-dist": "3.11.174"
  },
  "build": {
    "appId": "com.baskimasasi.app",
    "productName": "Baskı Masası",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Baskı Masası",
      "uninstallDisplayName": "Baskı Masası",
      "artifactName": "BaskiMasasi-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BaskiMasasi-Tasinabilir-${version}.${ext}"
    },
    "publish": null
  }
}
